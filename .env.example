# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAMESPACE=tempo
# local/staging/production solo cambian el prefijo de llaves.
# Si hay UPSTASH_REDIS_REST_URL/TOKEN, el limiter usa Upstash.
APP_ENV=local

# Turnstile (test key local; cambia en producción)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Supabase (Auth + Postgres)
# En local, `bun run db:start` imprime estos valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limiting y caché)
# Local con `bun run redis:up` (SRH):
# UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
# UPSTASH_REDIS_REST_TOKEN=devtoken
# Nota: @upstash/redis funciona con SRH; @upstash/ratelimit no,
# porque usa scripts Lua con el flag allow-key-locking.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Polar (Merchant of Record)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_ENVIRONMENT=sandbox

# URL pública para canonical, sitemap y hreflang
NEXT_PUBLIC_SITE_URL=https://tempo2.mgdc.site
