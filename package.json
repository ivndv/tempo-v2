{
	"name": "tempo-v2",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:types": "supabase gen types typescript --local > src/shared/infrastructure/db/database.types.ts",
		"redis:up": "docker compose -f docker-compose.redis.yml up -d",
		"redis:down": "docker compose -f docker-compose.redis.yml down",
		"redis:logs": "docker compose -f docker-compose.redis.yml logs -f",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"cf:build": "opennextjs-cloudflare build",
		"cf:preview": "opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"perf:resumen": "bun scripts/perf/resumen.ts"
	},
	"dependencies": {
		"@polar-sh/nextjs": "^1.1.0",
		"@polar-sh/sdk": "^1.0.2",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"@upstash/ratelimit": "^2.2.0",
		"@upstash/redis": "^1.39.0",
		"dexie": "^4.4.7",
		"dexie-react-hooks": "^4.4.0",
		"fflate": "^0.8.3",
		"lucide-react": "^1.61.0",
		"next": "16.4.3",
		"next-intl": "^4.14.9",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@opennextjs/cloudflare": "^1.20.13",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"fake-indexeddb": "^6.2.6",
		"supabase": "^2.122.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	}
}
